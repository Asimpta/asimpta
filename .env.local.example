# Formspree — endpoint do formulário de contato
# O form ID da Asimpta já está configurado.
# Para rodar localmente: copie este arquivo para .env.local e preencha com o endpoint real.
# Para deploy na Vercel: adicione a variável em Settings → Environment Variables.
# Formato: https://formspree.io/f/XXXXXXXX
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
